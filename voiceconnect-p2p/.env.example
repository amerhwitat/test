PORT=8787
# Set only when behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=0
# Optional absolute path for consent-based peer registry JSON.
# VOICECONNECT_REGISTRY=/path/to/private/peers.json
# Electron signaling proxy (does not tunnel WebRTC UDP media):
# HTTPS_PROXY=http://127.0.0.1:8080
# Configure TURN/TLS over TCP 443 in the app for firewall traversal.

# Production security: use independent random secrets of at least 32 characters.
VOICECONNECT_AUTH_SECRET= # required in production; generate with openssl rand -hex 32
# Admin-only API key for POST /api/invitations. Never expose to browser clients.
VOICECONNECT_ADMIN_SECRET= # admin-only API bearer secret
# Comma-separated exact browser origins, e.g. https://meet.example.com
ALLOWED_ORIGINS=
# Real coturn REST configuration (server-only shared secret).
TURN_URL=
TURN_SHARED_SECRET=
STUN_URL=stun:stun.l.google.com:19302

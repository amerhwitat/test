# Copy to .env.production; do not commit the real file.
DOMAIN=meet.example.com
ACME_EMAIL=admin@example.com
ALLOWED_ORIGINS=https://meet.example.com
VOICECONNECT_AUTH_SECRET=REPLACE_WITH_openssl_rand_hex_32_OR_LONGER
VOICECONNECT_ADMIN_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
TURN_REALM=meet.example.com
TURN_EXTERNAL_IP=YOUR_PUBLIC_SERVER_IPV4
TURN_SHARED_SECRET=REPLACE_WITH_A_THIRD_RANDOM_SECRET
TURN_URL=turn:meet.example.com:3478?transport=udp,turn:meet.example.com:3478?transport=tcp,turns:meet.example.com:5349?transport=tcp
STUN_URL=stun:meet.example.com:3478
PORT=8787
